# Public build-time settings (bundled into the browser; never put secrets here)
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=15000
VITE_API_WITH_CREDENTIALS=true
VITE_API_REFRESH_ENDPOINT=/auth/refresh
# Stripe publishable key (pk_test_... / pk_live_...); exposed to the browser via envPrefix
STRIPE_PUBLISHABLE_KEY=
